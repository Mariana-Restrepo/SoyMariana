# Copia este archivo a .env.local y completa los valores.
# Las variables VITE_* quedan visibles en el navegador: nunca pongas secretos aquí.

# URL pública del sitio (sin "/" al final). Se usa en canonical, Open Graph, sitemap y datos estructurados.
VITE_SITE_URL=https://tu-dominio.com

# Servicio que recibe el formulario de marcas (Formspree, Web3Forms, función serverless...).
# Recibe un POST con JSON: { name, brand, email, brandSocial, collabType, message, budget }.
# Si se deja vacío, el formulario abre el correo de quien escribe (mailto) como respaldo.
VITE_INQUIRY_ENDPOINT=
