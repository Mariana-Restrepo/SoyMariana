{
  "name": "@soymariana/web",
  "version": "1.0.0",
  "private": true,
  "description": "Soy Mariana - sitio web (React + Vite + TypeScript + Tailwind + Motion), instalable como PWA.",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @soymariana/tokens",
    "dev": "vite",
    "prebuild": "npm run build -w @soymariana/tokens",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "assets": "node scripts/generate-assets.mjs",
    "audit": "node scripts/audit.mjs",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@soymariana/content": "*",
    "@soymariana/core": "*",
    "@soymariana/tokens": "*",
    "motion": "^13.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "lighthouse": "^13.5.0",
    "opentype.js": "^2.0.0",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
