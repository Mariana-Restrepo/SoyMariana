# Copia este archivo a .env.local y completa los valores.
# Las variables EXPO_PUBLIC_* quedan visibles en la app: nunca pongas secretos aquí.

# Servicio que recibe el formulario de marcas (Formspree, Web3Forms, función serverless...).
# Recibe un POST con JSON: { name, brand, email, brandSocial, collabType, message, budget }.
# Si se deja vacío, el formulario abre el correo de quien escribe (mailto) como respaldo.
EXPO_PUBLIC_INQUIRY_ENDPOINT=

# URL base donde viven las imágenes/videos que en el JSON aparecen como rutas ("/media/foto.webp").
# Ejemplo: https://tu-dominio.com   (también puedes usar URLs completas https://... en el JSON)
EXPO_PUBLIC_MEDIA_BASE_URL=
