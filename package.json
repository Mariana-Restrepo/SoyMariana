{
  "name": "soymariana",
  "private": true,
  "version": "1.0.0",
  "description": "Soy Mariana - experiencia digital personal (web + móvil). Monorepo: apps/web (React + Vite), apps/mobile (Expo), packages/*",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "web": "npm run dev -w @soymariana/web",
    "web:lan": "npm run dev -w @soymariana/web -- --host",
    "mobile": "npm run start -w @soymariana/mobile",
    "mobile:tunnel": "npm run start -w @soymariana/mobile -- --tunnel",
    "dev": "npm run dev -w @soymariana/web",
    "build": "npm run build -w @soymariana/web",
    "preview": "npm run preview -w @soymariana/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check:content": "npm run check -w @soymariana/content",
    "check:content:strict": "npm run check:strict -w @soymariana/content",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:content",
    "tokens": "npm run build -w @soymariana/tokens",
    "assets": "npm run assets -w @soymariana/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
