# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo



# generated native folders
/ios
/android

# monorepo
**/node_modules/
**/dist/
**/.expo/
**/expo-env.d.ts
apps/web/dev-dist/
*.log
coverage/

# Los videos pesan: se alojan fuera de git (Cloudflare R2 / Bunny / Cloudinary) y solo se guarda la URL en el JSON.
apps/web/public/media/videos/*
!apps/web/public/media/videos/.gitkeep

# Fotos originales: pesan y pueden traer metadatos privados (GPS). Solo se sube su versión optimizada.
apps/web/media-src/*
!apps/web/media-src/README.md
